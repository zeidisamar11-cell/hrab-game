<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="HUD.uss" />
    <ui:VisualElement name="hud" class="hud" picking-mode="Ignore">
        <ui:VisualElement class="hud-group">
            <ui:Label text="Score :" class="hud-title" />
            <ui:Label name="score-value" text="0" class="score-value" />
        </ui:VisualElement>
        <ui:VisualElement class="hud-group">
            <ui:Label text="Vies :" class="hud-title" />
            <ui:VisualElement name="life-1" class="life" />
            <ui:VisualElement name="life-2" class="life" />
            <ui:VisualElement name="life-3" class="life" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
