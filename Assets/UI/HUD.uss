/* HUD : Score en haut à gauche, Vies en haut à droite */
.hud {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 30px 70px;
}

.hud-group {
    flex-direction: row;
    align-items: center;
}

.hud-title {
    color: rgb(248, 248, 248);
    font-size: 80px;
    -unity-font-style: bold;
    margin-right: 14px;
}

.score-value {
    color: rgb(248, 240, 32);
    font-size: 88px;
    -unity-font-style: bold;
}

.life {
    width: 80px;
    height: 80px;
    margin-left: 10px;
    background-image: url("PacLife.png");
}
